#include <winres.h>

// Icon id 1: tray + exe icon (same app.ico the C# build embeds).
1 ICON "../app.ico"

1 RT_MANIFEST "prayertray.manifest"

// FILEVERSION is patched from the git tag by CI (see .github/workflows/release.yml).
1 VERSIONINFO
FILEVERSION 0,0,0,0
PRODUCTVERSION 0,0,0,0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "DynamicEG"
            VALUE "FileDescription", "Prayer Tray"
            VALUE "FileVersion", "0.0.0"
            VALUE "ProductName", "PrayerTray"
            VALUE "ProductVersion", "0.0.0"
            VALUE "OriginalFilename", "PrayerTray.exe"
            VALUE "LegalCopyright", "MIT License"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
